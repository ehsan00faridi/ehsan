@using Domain.Models.User
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> _signInManager

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت محصول</title>
    <!-- لود نسخه راست‌چین بوت‌استرپ ۵ -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <!-- آیکون‌های بوت‌استرپ برای زیبایی بصری -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Application.styles.css" asp-append-version="true" />




    <style>
        /* استایل‌های سفارشی برای هدر و فوتر مدرن */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        .navbar {
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }

        .nav-link {
            font-weight: 500;
            transition: color 0.2s ease-in-out;
        }

            .nav-link:hover {
                color: #0d6efd !important;
            }

        /* استایل سفارشی برای نوار جستجو در وسط */
        .search-bar {
            max-width: 450px;
            width: 100%;
        }

            .search-bar input {
                border-radius: 0 20px 20px 0 !important;
                border-left: 0;
                padding-right: 15px;
            }

            .search-bar button {
                border-radius: 20px 0 0 20px !important;
                border-right: 0;
            }

            .search-bar input:focus {
                box-shadow: none;
                border-color: #dee2e6;
            }

        .footer {
            background-color: #1e293b;
            color: #cbd5e1;
        }

            .footer a {
                color: #94a3b8;
                text-decoration: none;
                transition: color 0.2s ease;
            }

                .footer a:hover {
                    color: #f8fafc;
                }

        .avatar-circle {
            width: 32px;
            height: 32px;
            background-color: #e2e8f0;
            color: #475569;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .navbar-logo {
            max-height: 45px;
            width: auto;
            object-fit: contain;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container">

            
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary fs-4" asp-area="" asp-controller="Home" asp-action="Index">
              
                    <img src="~/api/Fileroot/GetFile?filename=Logo.JPG" alt="لوگو" class="navbar-logo" onerror="this.onerror=null; this.src='';" />
                </a>

        
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    
                    <ul class="navbar-nav mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark py-2 px-2 rounded" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> خانه
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark py-2 px-2 rounded" asp-area="" asp-controller="Home" asp-action="Basket">
                                <i class="bi bi-basket me-1"></i> سبد خرید
                            </a>
                        </li>
                    </ul>

                
                    <div class="mx-auto my-3 my-lg-0 search-bar">
                        <form asp-controller="Product" asp-action="ProductList" method="get" class="input-group">
                            <input value="@ViewBag.search"
                                   name="Search" class="form-control bg-light border-secondary border-opacity-25" placeholder="جستجو در محصولات..." aria-label="Search" autocomplete="off" />
                            <button class="btn btn-warning text-white" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>
                    </div>



                    <div class="d-flex align-items-center gap-3">
                        @if (_signInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <a class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border rounded-pill py-1.5 px-3" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="avatar-circle">
                                        @User.Identity?.Name?[0].ToString().ToUpper()
                                    </div>
                                    <span class="fw-semibold text-dark small">@User.Identity?.Name</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> خروج از حساب
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary rounded-pill px-4" asp-area="" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-left me-1"></i> ورود / ثبت‌نام
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-5 mt-auto border-top border-secondary border-opacity-10">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam-fill text-warning"></i> سامانه محصولات
                    </h5>
                    <p class="text-muted small lh-lg">
                        این پروژه جهت مدیریت بهینه محصولات طراحی شده است. از تکنولوژی‌های روز برای کارایی بالاتر و تجربه کاربری روان‌تر استفاده می‌کنیم.
                    </p>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">دسترسی سریع</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-left small me-1"></i> صفحه نخست</a></li>
                        <li><a asp-controller="Home" asp-action="Basket"><i class="bi bi-chevron-left small me-1"></i> سبد خرید</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-chevron-left small me-1"></i> حریم خصوصی</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">ارتباط با ما</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small text-muted">
                        <li><i class="bi bi-telephone me-2 text-warning"></i> ۰۲۱-۱۲۳۴۵۶۷۸</li>
                        <li><i class="bi bi-envelope me-2 text-warning"></i> info@example.com</li>
                        <li><i class="bi bi-geo-alt me-2 text-warning"></i> تهران، خیابان آزادی</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4 opacity-25" />

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <span class="small text-muted">&copy; ۲۰۲۶ - تمامی حقوق برای نرم‌افزار محفوظ است.</span>
                <div class="d-flex gap-3">
                    <a href="#" class="fs-5 text-muted"><i class="bi bi-telegram"></i></a>
                    <a href="#" class="fs-5 text-muted"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="fs-5 text-muted"><i class="bi bi-github"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
