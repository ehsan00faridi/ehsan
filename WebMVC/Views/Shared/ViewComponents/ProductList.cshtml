@using Application.Command.Pagination

 
@model PaginatedList<Domain.Models.Products.ProductDto>

@if (Model?.Items != null && Model.Items.Any())
{
    foreach (var item in Model.Items)
    {
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card book-card h-100 border-0 shadow-sm">
           
                <img src="~/api/Fileroot/GetFile?filename=@item.Img"
                     width="100%"
                     height="200px" />
                <div class="card-body d-flex flex-column">
                    <p>@item.Img</p>
                    <h6 class="fw-bold text-truncate">@item.Name</h6>
                    <h6 class="fw-bold text-truncate">@item.Price</h6>

                    <a asp-controller="Product"
                       asp-action="GetProduct"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-primary btn-sm w-100 mt-auto">
                        مشاهده جزئیات
                    </a>
                </div>
            </div>
        </div>
    }
}
else
{
    <div>محصولی یافت نشد</div>
}






