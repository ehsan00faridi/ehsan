@using Application.Command.Pagination
@model PaginatedList<Domain.Models.Products.ProductDto>

<!-- Swiper CSS (CDN) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />



<div class="position-relative my-4" dir="rtl">

    <!-- Swiper Container -->
    <div class="swiper product-swiper">
        <div class="swiper-wrapper">

            @if (Model?.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <div class="swiper-slide h-auto">
                        <div class="card book-card h-100 border-0 shadow-sm">
                            <img src="~/api/Fileroot/GetFile?filename=@item.Img"
                                 class="w-100 book-img"
                                 height="200px"
                                 alt="@item.Name"
                                 title="@item.Name" />

                            <div class="card-body d-flex flex-column text-right">
                                <h6 class="fw-bold text-truncate text-dark mb-2">@item.Name</h6>
                                <p class="text-primary fw-bold mb-3">@item.Price.ToString("N0") تومان</p>

                                <a asp-controller="Product"
                                   asp-action="GetProduct"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm w-100 mt-auto">
                                    مشاهده جزئیات
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 w-100">
                    <p class="text-muted">محصولی یافت نشد</p>
                </div>
            }

        </div>

        <!-- Navigation Buttons -->
        <div class="swiper-button-next text-primary"></div>
        <div class="swiper-button-prev text-primary"></div>

        <!-- Pagination Dots -->
        <div class="swiper-pagination"></div>
    </div>
</div>

<!-- Swiper JS (CDN) -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<!-- Initialize Swiper -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const swiper = new Swiper('.product-swiper', {
           
            rtl: true,
            slidesPerView: 1,
            spaceBetween: 15,
            loop: false,
            autoplay: {
                delay: 3500,
                disableOnInteraction: false,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
          
            breakpoints: {
                576: {
                    slidesPerView: 2,
                    spaceBetween: 15,
                },
                768: {
                    slidesPerView: 3,
                    spaceBetween: 20,
                },
                1200: {
                    slidesPerView: 4,
                    spaceBetween: 25,
                }
            }
        });
    });
</script>
