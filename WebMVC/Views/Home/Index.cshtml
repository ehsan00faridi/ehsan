@using Application.Command.Pagination
@using Application.Features.Products.Dto

@{
    ViewData["Title"] = "Home Page";

    int pageNumber = 1;
    int pageSize = 6;

    if (int.TryParse(Context.Request.Query["pageNumber"], out var p) && p > 0)
    {
        pageNumber = p;
    }

    if (int.TryParse(Context.Request.Query["pageSize"], out var s) && s > 0)
    {
        pageSize = s;
    }

    string search = Context.Request.Query["search"].ToString() ?? "";
}




<form class="d-flex justify-content-center mb-4"
      asp-controller="Product"
      asp-action="ProductList"
      method="get">
    <div class="input-group w-50">
        <input value="@ViewBag.search"
               name="Search"
               class="form-control"
               placeholder="جستجوی محصولات یا توضیحات..." />

        <button class="btn btn-primary" type="submit">
            <i class="fa fa-search"></i>
        </button>
    </div>
</form>


<div class="container">
    <div class="row g-4">
        @await Component.InvokeAsync("ProductList", new
        {
            pageNumber = pageNumber,
                pageSize = 20,
                search = search,
                disablePaging = false
                })
    </div>
</div>
