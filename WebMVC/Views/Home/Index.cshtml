@* @using Application.Command.Pagination
@using Application.Features.Products.Dto *@
@using Application.Command.Pagination
@using Domain.Models.Products
@model PaginatedList<ProductDto>


@{
    ViewData["Title"] = "Home Page";

    int pageNumber = 1;
    int pageSize = 6;

    if (int.TryParse(Context.Request.Query["pageNumber"], out var p) && p > 0)
    {
        pageNumber = p;
    }

    if (int.TryParse(Context.Request.Query["pageSize"], out var s) && s > 0)
    {
        pageSize = s;
    }

    string search = Context.Request.Query["search"].ToString() ?? "";
}







<div class="container">
    <div class="row g-4">
        @await Component.InvokeAsync("ProductList", new
        {
            pageNumber = pageNumber,
                pageSize = 20,
                search = search,
                disablePaging = false
                })
    </div>
</div>




<div class="container mt-4">

    <!-- Title -->




    <div class="row g-4">

        @foreach (var item in Model.Items)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card book-card h-100 border-0 shadow-sm">

                    <img src="~/api/Fileroot/GetFile?filename=@item.Img"
                         class="card-img-top book-img"
                         alt="@item.Name" />

                    <div class="card-body d-flex flex-column">
                        <h6 class="fw-bold text-truncate">@item.Name</h6>
                        <p class="text-muted small flex-grow-1">
                            @item.Price تومان:
                        </p>

                        <a asp-controller="Product"
                           asp-action="GetProduct"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm w-100 mt-auto">
                            مشاهده جزئیات
                        </a>


                    </div>
                </div>
            </div>
        }

    </div>


    <!-- Pagination -->
    <nav class="mt-5 d-flex justify-content-center">
        <ul class="pagination">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                      
                       asp-action="GetProductList"
                       asp-controller="Product"
                       asp-route-search="@ViewBag.search"
                       asp-route-PageNumber="@i">
                        @i
                    </a>
                </li>
            }

        </ul>
    </nav>

</div>


