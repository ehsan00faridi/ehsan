@model LoginDto
@{
    ViewData["Title"] = "ورود به حساب";
}
@using Domain.Models.User
@using Microsoft.AspNetCore.Identity
@* @model RegisterDto *@

@inject SignInManager<User> _signInManager



@if (!_signInManager.IsSignedIn(User))
{


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h3 class="text-center mb-4">خوش آمدید</h3>
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" id="emailInput" placeholder="name@example.com">
                            <label for="emailInput">ایمیل</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" type="password" class="form-control" id="passInput" placeholder="Password">
                            <label for="passInput">کلمه عبور</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">
                                مرا به خاطر بسپار
                            </label>
                        </div>

                        <button class="w-100 btn btn-lg btn-success" type="submit">ورود به پنل</button>
                    </form>
                    <div class="mt-3 text-center">
                        <small>هنوز ثبت نام نکرده‌اید؟ <a asp-action="Register">ایجاد حساب</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}
else
{
    <h1>شما وارد شده اید</h1>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
