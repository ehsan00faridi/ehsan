
@{
    ViewData["Title"] = "ManageRoles";
}

@model ManageUserRolesViewModel

<h2>Manage Roles for @Model.UserId</h2>

<form asp-action="ManageRoles" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label>Select Roles</label>
        @foreach (var role in Model.AvailableRoles)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                @(Model.AssignedRoles.Contains(role) ? "checked" : "") />
                <label class="form-check-label">
                    @role
                </label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
