@using Domain.Models.Products

@model ProductDto

@{
    ViewData["Title"] = "ویرایش محصول";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0">ویرایش محصول: @Model.Name</h4>
                </div>

                <div class="card-body p-4">

                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="UpdateProduct"
                          asp-controller="Product"
                          method="post"
                          enctype="multipart/form-data">

                        @* فیلد مخفی برای نگه داشتن شناسه محصول *@
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">نام محصول</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label">قیمت (تومان)</label>
                                <input asp-for="Price" type="number" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Qty" class="form-label">تعداد موجودی</label>
                                <input asp-for="Qty" type="number" class="form-control" />
                                <span asp-validation-for="Qty" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label">وزن</label>
                                <input asp-for="Weight" class="form-control" />
                                <span asp-validation-for="Weight" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="material" class="form-label">جنس یا مواد تشکیل‌دهنده</label>
                                <textarea asp-for="material" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="material" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                              
                                <div id="imagePreviewContainer" class="mt-3">
                                   @*  <img id="imagePreview"
                                         src="@(!string.IsNullOrEmpty(Model.Img) ? "/images/products/" + Model.Img : "#")"
                                         alt="تصویر محصول"
                                         class="img-thumbnail @(string.IsNullOrEmpty(Model.Img) ? "d-none" : "")"
                                         style="width: 180px; height: 180px; object-fit: cover;" /> *@

                                    <input name="Imgfile"
                                           type="file"
                                           style="width: 180px; height: 180px; object-fit: cover;" />
                                </div>
                            </div>

                            <input asp-for="Img" type="hidden" />

                            <div class="col-12 mt-4">
                                <hr />
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Index" asp-controller="Product" class="btn btn-outline-secondary">انصراف</a>
                                    <button type="submit" class="btn btn-warning px-4 text-white">ذخیره تغییرات</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showImagePreview(event) {
            const file = event.target.files[0];
            const preview = document.getElementById("imagePreview");

            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.classList.remove("d-none");
            }
        }
    </script>
}
