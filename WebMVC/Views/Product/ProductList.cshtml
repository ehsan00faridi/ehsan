@using Application.Command.Pagination
@using Domain.Models.Products
@model PaginatedList<ProductDto>

@{
    ViewData["Title"] = "ProductList";
}

<h1>hello </h1>


<div class="container mt-4">

    <!-- Title -->
    <div class="text-center mb-4">
        <h2 class="fw-bold"> تمام محصولات</h2>
    </div>

    <!-- Search -->
    <form class="d-flex justify-content-center mb-4"
          asp-action="ProductList"
          asp-route-page="1">
        <div class="input-group w-50">
            <input value="@ViewBag.search"
                   name="search"
                   class="form-control"
                   placeholder="جستجوی محصولات یا توضیحات..." />
            <button class="btn btn-primary" type="submit">
                <i class="fa fa-search"></i>
            </button>
        </div>
    </form>




    <!-- Books Grid -->
    <div class="row g-4">

        @foreach (var item in Model.Items)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card book-card h-100 border-0 shadow-sm">

                    <img src="~/api/Fileroot/GetFile?filename=@item.Img"
                         class="card-img-top book-img"
                         alt="@item.Name" />

                    <div class="card-body d-flex flex-column">
                        <h6 class="fw-bold text-truncate">@item.Name</h6>
                        <p class="text-muted small flex-grow-1">
                            @item.Price تومان:
                        </p>
                        



                    </div>
                </div>
            </div>
        }

    </div>


@*     <!-- Pagination -->
    <nav class="mt-5 d-flex justify-content-center">
