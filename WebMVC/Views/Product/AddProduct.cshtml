@using Application.Features.Products.Command
@model AddProductCommand

@{
    ViewData["Title"] = "افزودن محصول";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">افزودن محصول جدید</h4>
                </div>

                <div class="card-body p-4">

                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @successMessage
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>
                        </div>
                    }

                    <form asp-action="AddProduct"
                          asp-controller="Product"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">
                                    نام محصول
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="نام محصول را وارد کنید" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label">
                                    قیمت
                                </label>

                                <div class="input-group">
                                    <input asp-for="Price"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           class="form-control"
                                           placeholder="قیمت محصول" />

                                    <span class="input-group-text">تومان</span>
                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Qty" class="form-label">
                                    تعداد موجودی
                                </label>

                                <input asp-for="Qty"
                                       type="number"
                                       min="0"
                                       class="form-control"
                                       placeholder="تعداد موجودی" />

                                <span asp-validation-for="Qty"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label">
                                    وزن
                                </label>

                                <input asp-for="Weight"
                                       class="form-control"
                                       placeholder="مثلاً 500 گرم" />

                                <span asp-validation-for="Weight"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="material" class="form-label">
                                    جنس یا مواد تشکیل‌دهنده
                                </label>

                                <textarea asp-for="material"
                                          class="form-control"
                                          rows="3"
                                          placeholder="جنس یا مواد تشکیل‌دهنده محصول"></textarea>

                                <span asp-validation-for="material"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Img" class="form-label">
                                    تصویر محصول
                                </label>

                                <input asp-for="Img"
                                       type="file"
                                       class="form-control"
                                       accept="image/jpeg,image/png,image/webp"
                                       onchange="showImagePreview(event)" />

                                <span asp-validation-for="Img"
                                      class="text-danger">
                                </span>

                                <div id="imagePreviewContainer"
                                     class="mt-3 d-none">
                                    <img id="imagePreview"
                                         src=""
                                         alt="پیش‌نمایش تصویر محصول"
                                         class="img-thumbnail"
                                         style="width: 180px; height: 180px; object-fit: cover;" />
                                </div>
                            </div>

                            <input asp-for="imgname" type="hidden" />

                            <div class="col-12 mt-4">
                                <hr />

                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Index"
                                       asp-controller="Product"
                                       class="btn btn-outline-secondary">
                                        انصراف
                                    </a>

                                    <button type="submit"
                                            class="btn btn-primary px-4">
                                        ثبت محصول
                                    </button>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function showImagePreview(event) {
            const file = event.target.files[0];
            const preview = document.getElementById("imagePreview");
            const container = document.getElementById("imagePreviewContainer");

            if (!file) {
                preview.src = "";
                container.classList.add("d-none");
                return;
            }

            if (!file.type.startsWith("image/")) {
                event.target.value = "";
                preview.src = "";
                container.classList.add("d-none");
                alert("لطفاً فقط فایل تصویری انتخاب کنید.");
                return;
            }

            preview.src = URL.createObjectURL(file);
            container.classList.remove("d-none");

            preview.onload = function () {
                URL.revokeObjectURL(preview.src);
            };
        }
    </script>
}
